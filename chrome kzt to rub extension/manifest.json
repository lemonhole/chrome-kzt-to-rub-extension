{
  "manifest_version": 3,
  "name": "chrome-kzt-to-rub-extension",
  "version": "0.1",
  "description": "Конвертирует цены из KZT в RUB на веб-страницах.",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
