{
  "manifest_version": 3,
  "name": "chrome-kzt-to-rub-extension",
  "version": "0.2",
  "description": "Конвертирует KZT в RUB",
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
